<Window x:Class="TerraCompanion.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TerraCompanion" Width="1380" Height="880" MinWidth="980" MinHeight="620"
        Icon="/Assets/TerraCompanion.ico"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="210"/>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- sidebar -->
    <Border Grid.RowSpan="2" Background="#111317" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="14,16,14,20">
          <Image DockPanel.Dock="Left" Source="/Assets/TreeIcon.png" Width="32" Height="32" Margin="0,0,8,0"
                 VerticalAlignment="Center" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="TerraCompanion" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
            <TextBlock x:Name="GameVersionText" Text="Looking for Terraria..." Style="{StaticResource Hint}" Margin="0,1,0,0"/>
          </StackPanel>
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Margin="18,0,18,14" Style="{StaticResource Hint}" FontSize="11"
                   Text="Not affiliated with Re-Logic. Back up your saves."/>
        <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" Margin="8,0" SelectionChanged="Nav_SelectionChanged">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
              <Setter Property="Padding" Value="12,9"/>
              <Setter Property="Margin" Value="0,1"/>
              <Setter Property="FontSize" Value="14"/>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBoxItem Tag="game">⚙  Game &amp; Patch</ListBoxItem>
          <ListBoxItem Tag="tweaks">🌍  World Rules</ListBoxItem>
          <ListBoxItem Tag="items">🗡  Item Editor</ListBoxItem>
          <ListBoxItem Tag="npcs">👾  NPC Editor</ListBoxItem>
          <ListBoxItem Tag="world">🗺  World Viewer</ListBoxItem>
          <ListBoxItem Tag="player">🎒  Character Editor</ListBoxItem>
          <ListBoxItem Tag="raw">📝  Raw Rules</ListBoxItem>
        </ListBox>
      </DockPanel>
    </Border>

    <ContentControl x:Name="Host" Grid.Column="1" Margin="24,20,24,10"/>

    <!-- status bar -->
    <Border Grid.Row="1" Grid.Column="1" Background="#111317" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,5">
      <DockPanel>
        <TextBlock x:Name="RunningText" DockPanel.Dock="Right" Style="{StaticResource Hint}"/>
        <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
