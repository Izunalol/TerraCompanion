<Window x:Class="TerraCompanion.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TerraCompanion" Width="1380" Height="880" MinWidth="980" MinHeight="620"
        Icon="/Assets/TerraCompanion.ico"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="224"/>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- sidebar -->
    <Border Grid.RowSpan="2" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="16,18,14,18">
          <Image DockPanel.Dock="Left" Source="/Assets/TreeIcon.png" Width="34" Height="34" Margin="0,0,10,0"
                 VerticalAlignment="Center" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="TerraCompanion" FontFamily="{StaticResource UiDisplayFont}" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock x:Name="GameVersionText" Text="Looking for Terraria..." Style="{StaticResource Hint}" Margin="0,1,0,0"/>
          </StackPanel>
        </DockPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="14,0,14,14">
          <TextBlock Text="Appearance" Style="{StaticResource Hint}" Margin="2,0,0,4"/>
          <ComboBox x:Name="ThemeBox" SelectionChanged="ThemeBox_SelectionChanged">
            <ComboBoxItem Tag="auto">Automatic</ComboBoxItem>
            <ComboBoxItem Tag="light">Light</ComboBoxItem>
            <ComboBoxItem Tag="dark">Dark</ComboBoxItem>
          </ComboBox>
          <TextBlock Margin="2,10,0,0" Style="{StaticResource Hint}" FontSize="11" Text="Not affiliated with Re-Logic. Back up your saves."/>
        </StackPanel>

        <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" Margin="8,0" Padding="0" SelectionChanged="Nav_SelectionChanged">
          <ListBox.Template>
            <ControlTemplate TargetType="ListBox">
              <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
            </ControlTemplate>
          </ListBox.Template>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavItem}"/>
          </ListBox.ItemContainerStyle>
          <ListBoxItem Tag="game"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE713;" Width="26" FontSize="15" VerticalAlignment="Center"/><TextBlock Text="Game &amp; Patch" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
          <ListBoxItem Tag="tweaks"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE774;" Width="26" FontSize="15" VerticalAlignment="Center"/><TextBlock Text="World Rules" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
          <ListBoxItem Tag="items"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70F;" Width="26" FontSize="15" VerticalAlignment="Center"/><TextBlock Text="Item Editor" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
          <ListBoxItem Tag="npcs"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE716;" Width="26" FontSize="15" VerticalAlignment="Center"/><TextBlock Text="NPC Editor" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
          <ListBoxItem Tag="world"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE707;" Width="26" FontSize="15" VerticalAlignment="Center"/><TextBlock Text="World Viewer" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
          <ListBoxItem Tag="player"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE77B;" Width="26" FontSize="15" VerticalAlignment="Center"/><TextBlock Text="Character Editor" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
          <ListBoxItem Tag="raw"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8A5;" Width="26" FontSize="15" VerticalAlignment="Center"/><TextBlock Text="Raw Rules" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
        </ListBox>
      </DockPanel>
    </Border>

    <ContentControl x:Name="Host" Grid.Column="1" Margin="28,22,28,10"/>

    <!-- status bar -->
    <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="18,6">
      <DockPanel>
        <TextBlock x:Name="RunningText" DockPanel.Dock="Right" Style="{StaticResource Hint}"/>
        <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
