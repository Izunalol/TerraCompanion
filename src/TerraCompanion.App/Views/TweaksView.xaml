<UserControl x:Class="TerraCompanion.App.Views.TweaksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
      <TextBlock Style="{StaticResource H1}" Text="World Rules"/>
      <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,0,0,6"
                 Text="Game-wide tweaks. Every change is saved to your rules file immediately and picked up by the patched game within a second (items in your inventory refresh too)."/>
      <TextBlock x:Name="NotPatchedHint" Style="{StaticResource Hint}" Foreground="{StaticResource Warn}" Visibility="Collapsed" Margin="0,0,0,6"
                 Text="The game is not patched yet - these rules do nothing until you patch it on the Game &amp; Patch page."/>

      <TextBlock Style="{StaticResource H2}" Text="Enemy spawning"/>
      <Border Style="{StaticResource Card}">
        <StackPanel x:Name="SpawnPanel"/>
      </Border>

      <TextBlock Style="{StaticResource H2}" Text="Display"/>
      <Border Style="{StaticResource Card}">
        <StackPanel x:Name="DisplayPanel"/>
      </Border>

      <TextBlock Style="{StaticResource H2}" Text="Cooldowns"/>
      <Border Style="{StaticResource Card}">
        <StackPanel x:Name="CooldownPanel"/>
      </Border>

      <TextBlock Style="{StaticResource H2}" Text="Item groups"/>
      <Border Style="{StaticResource Card}">
        <StackPanel x:Name="ItemPanel"/>
      </Border>

      <TextBlock Style="{StaticResource H2}" Text="Enemies &amp; bosses"/>
      <Border Style="{StaticResource Card}">
        <StackPanel x:Name="NpcPanel"/>
      </Border>

      <Button Content="Reset all world rules" Style="{StaticResource Danger}" HorizontalAlignment="Left" Margin="0,16,0,20" Click="ResetAll_Click"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
