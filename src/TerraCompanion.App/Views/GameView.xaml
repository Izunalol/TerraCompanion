<UserControl x:Class="TerraCompanion.App.Views.GameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
      <TextBlock Style="{StaticResource H1}" Text="Game &amp; Patch"/>
      <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,0,0,14"
                 Text="TerraCompanion changes game values without tModLoader by adding a tiny hook to Terraria.exe. The hook reads your rules file while you play, so edits apply within a second. Saves, worlds and multiplayer compatibility are untouched; Restore puts back the exact original file."/>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Terraria folder" FontWeight="SemiBold"/>
          <DockPanel Margin="0,6,0,0">
            <Button DockPanel.Dock="Right" Content="Browse..." Click="Browse_Click" Margin="6,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="Detect" Click="Detect_Click" Margin="6,0,0,0"/>
            <TextBox x:Name="GameDirBox" IsReadOnly="True"/>
          </DockPanel>
          <TextBlock Text="Save folder (players, worlds, rules)" FontWeight="SemiBold" Margin="0,12,0,0"/>
          <DockPanel Margin="0,6,0,0">
            <Button DockPanel.Dock="Right" Content="Open" Click="OpenSaves_Click" Margin="6,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseSaves_Click" Margin="6,0,0,0"/>
            <TextBox x:Name="SaveDirBox" IsReadOnly="True"/>
          </DockPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,12,0,0">
        <StackPanel>
          <DockPanel>
            <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="{DynamicResource Muted}" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <StackPanel>
              <TextBlock x:Name="StatusTitle" FontSize="16" FontWeight="SemiBold" Text="Checking..."/>
              <TextBlock x:Name="StatusDetail" Style="{StaticResource Hint}"/>
            </StackPanel>
          </DockPanel>
          <WrapPanel Margin="0,14,0,0">
            <Button x:Name="PatchButton" Style="{StaticResource Primary}" Content="Patch game" Click="Patch_Click"/>
            <Button x:Name="RestoreButton" Style="{StaticResource Danger}" Content="Restore original" Click="Restore_Click"/>
            <Button x:Name="LaunchButton" Content="▶ Launch Terraria" Click="Launch_Click"/>
            <CheckBox x:Name="ServerCheck" Content="Also patch TerrariaServer.exe (for dedicated servers)" Margin="10,0,0,0" VerticalAlignment="Center"/>
          </WrapPanel>
          <TextBlock x:Name="PatchLog" Style="{StaticResource Hint}" Margin="0,10,0,0" FontFamily="Consolas"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,12,0,0">
        <StackPanel>
          <DockPanel>
            <Ellipse x:Name="Status64Dot" Width="12" Height="12" Fill="{DynamicResource Muted}" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <StackPanel>
              <TextBlock FontSize="16" FontWeight="SemiBold"><Run Text="64-bit Terraria"/><Run Text="  experimental" FontSize="12" Foreground="{DynamicResource Warn}"/></TextBlock>
              <TextBlock x:Name="Status64Detail" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
            </StackPanel>
          </DockPanel>
          <TextBlock Style="{StaticResource Hint}" Margin="22,8,0,0" TextWrapping="Wrap"
                     Text="Builds a separate copy of your (patched) vanilla game that runs as a 64-bit .NET 8 program on FNA, the engine tModLoader uses, instead of the 32-bit .NET Framework and XNA. Same game version, saves, settings, Steam and multiplayer; your normal Terraria.exe is not touched. FNA and the 64-bit Steam library come from your tModLoader install."/>
          <WrapPanel Margin="0,12,0,0">
            <Button x:Name="Build64Button" Style="{StaticResource Primary}" Content="Build 64-bit version" Click="Build64_Click"/>
            <Button x:Name="Launch64Button" Content="▶ Launch 64-bit" Click="Launch64_Click"/>
            <Button x:Name="Remove64Button" Style="{StaticResource Danger}" Content="Remove" Click="Remove64_Click"/>
          </WrapPanel>
          <CheckBox x:Name="Prefer64Check" Margin="0,10,0,0" Click="Prefer64_Click">
            <TextBlock Text="Make ▶ Launch Terraria start the 64-bit version" FontWeight="SemiBold"/>
          </CheckBox>
          <TextBlock x:Name="Log64" Style="{StaticResource Hint}" Margin="0,10,0,0" FontFamily="Consolas" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <TextBlock Style="{StaticResource H2}" Text="Good to know"/>
      <TextBlock Style="{StaticResource Hint}" FontSize="13" LineHeight="20">
        • Patch while Terraria is closed. After a Steam update, the game is vanilla again - just press Patch again.<LineBreak/>
        • Rules only affect the game where the patch is installed. In multiplayer, the host / server needs the patch (and the same rules) for item and NPC changes to count.<LineBreak/>
        • The first launch after patching exports the vanilla item and NPC stats, so the editors can show original values next to yours.<LineBreak/>
        • Steam's "Verify integrity of game files" also restores the original Terraria.exe.
      </TextBlock>

      <TextBlock Style="{StaticResource H2}" Text="Hook log (from the last game session)"/>
      <Border Style="{StaticResource Card}" Padding="10">
        <DockPanel>
          <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Content="Refresh" Click="RefreshLog_Click" Margin="0,0,0,8"/>
          <TextBox x:Name="LogBox" VerticalAlignment="Stretch" IsReadOnly="True" FontFamily="Consolas" FontSize="12" Height="160" TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
        </DockPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
