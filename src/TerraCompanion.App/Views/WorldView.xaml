<UserControl x:Class="TerraCompanion.App.Views.WorldView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="310"/>
      <ColumnDefinition Width="16"/>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Style="{StaticResource H1}" Text="World Viewer"/>
        <DockPanel Margin="0,4,0,6">
          <Button DockPanel.Dock="Right" Content="Open file..." Click="OpenFile_Click" Margin="6,0,0,0"/>
          <Button DockPanel.Dock="Right" Content="↻" ToolTip="Refresh list" Click="RefreshList_Click" Margin="6,0,0,0" Padding="9,6"/>
          <TextBlock Text="Your worlds" VerticalAlignment="Center" FontWeight="SemiBold"/>
        </DockPanel>
        <ListBox x:Name="WorldList" Height="150" DisplayMemberPath="Display" SelectionChanged="WorldList_SelectionChanged"/>

        <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="12">
          <TextBlock x:Name="InfoText" TextWrapping="Wrap" FontSize="12" LineHeight="18" Text="Pick a world to preview it."/>
        </Border>

        <TextBlock Style="{StaticResource H2}" Text="Layers"/>
        <WrapPanel>
          <CheckBox x:Name="ShowTiles" Content="Blocks" IsChecked="True" Margin="0,0,14,0" Click="Layer_Click"/>
          <CheckBox x:Name="ShowWalls" Content="Walls" IsChecked="True" Margin="0,0,14,0" Click="Layer_Click"/>
          <CheckBox x:Name="ShowLiquids" Content="Liquids" IsChecked="True" Margin="0,0,14,0" Click="Layer_Click"/>
          <CheckBox x:Name="ShowBackground" Content="Background" IsChecked="True" Margin="0,0,14,0" Click="Layer_Click"/>
          <CheckBox x:Name="ShowChests" Content="Chests" IsChecked="False" Click="Markers_Click"/>
        </WrapPanel>

        <TextBlock Style="{StaticResource H2}" Text="Highlight blocks"/>
        <ComboBox x:Name="HighlightBox" SelectionChanged="Highlight_Changed"/>
        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="Everything else is greyed out - handy for finding ores, life crystals or Plantera bulbs."/>

        <TextBlock Style="{StaticResource H2}" Text="Find items in chests"/>
        <TextBox x:Name="ChestSearch" TextChanged="ChestSearch_TextChanged"/>
        <ListBox x:Name="ChestResults" Height="170" Margin="0,6,0,0" SelectionChanged="ChestResults_SelectionChanged"/>

        <Button Content="Export map as PNG..." Margin="0,14,0,10" HorizontalAlignment="Left" Click="Export_Click"/>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Column="2" Background="#0C0D10" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
      <Grid>
        <Canvas x:Name="Viewport" Background="Transparent" ClipToBounds="True"
                MouseWheel="Viewport_MouseWheel" MouseLeftButtonDown="Viewport_MouseDown" MouseLeftButtonUp="Viewport_MouseUp"
                MouseMove="Viewport_MouseMove" MouseLeave="Viewport_MouseLeave" SizeChanged="Viewport_SizeChanged">
          <Image x:Name="MapImage" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
          <Canvas x:Name="Overlay" IsHitTestVisible="False"/>
        </Canvas>
        <TextBlock x:Name="Placeholder" Text="No world loaded" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8E8E93" FontSize="16"/>
        <Border x:Name="LoadingPanel" Background="#CC0C0D10" Visibility="Collapsed">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
            <TextBlock x:Name="LoadingText" Foreground="#F2F2F7" Text="Loading world..." HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <ProgressBar x:Name="LoadingBar" Height="6" Maximum="1" Foreground="{DynamicResource Accent}" Background="#3A3A3C" BorderThickness="0"/>
          </StackPanel>
        </Border>
        <!-- hover readout -->
        <Border x:Name="HoverPanel" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="10" Background="{DynamicResource Overlay}" CornerRadius="8" Padding="12,8"
                BorderBrush="{DynamicResource Line}" BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False" MaxWidth="460">
          <TextBlock x:Name="HoverText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8">
          <Button Content="Fit" Click="Fit_Click" Padding="10,4"/>
          <Button Content="Spawn" Click="GoSpawn_Click" Padding="10,4"/>
          <Button Content="Dungeon" Click="GoDungeon_Click" Padding="10,4" Margin="0"/>
        </StackPanel>
        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Style="{StaticResource Hint}" Foreground="#8E8E93" IsHitTestVisible="False"
                   Text="Scroll to zoom · drag to pan · hover a chest to see its contents"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>
